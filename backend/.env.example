# Portal passwords are NOT stored anywhere. You sign in through the browser
# window the cockpit opens, and only the session cookies are persisted.
#
# These optional vars seed a starter profile and, when set, prefill the login
# form as a convenience. Profiles created in the cockpit need none of them.
PROFILE_1_LINKEDIN_EMAIL=john@example.com
PROFILE_1_LINKEDIN_PASSWORD=changeme
PROFILE_1_GLASSDOOR_EMAIL=john@example.com
PROFILE_1_GLASSDOOR_PASSWORD=changeme

# PROFILE_2_LINKEDIN_EMAIL=jane@example.com
# PROFILE_2_LINKEDIN_PASSWORD=changeme

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkedin_apply?sslmode=disable

# Server / automation
PORT=8080
DATA_DIR=..          # directory holding data_profileN.json
HEADLESS=false       # sign-in opens a real window; needs a display (see README)
